# 복사해서 .env 로 쓰거나 OS 환경변수로 설정 (.env 는 커밋되지 않음)
DESK_MODE=paper              # paper | kis_mock | live
DESK_EQUITY=10000000
DESK_TOP_N=100
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# KIS (kis_mock / live 에서만 필요)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
KIS_ACCOUNT_PROD=01
# 실전 주문 잠금 해제 문구 — 의도할 때만 채울 것
DESK_LIVE_CONFIRM=
# AI 해설 (판정에는 쓰지 않음)
DESK_AI=off                  # off | anthropic | ollama
ANTHROPIC_API_KEY=
